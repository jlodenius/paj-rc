{
  "name": "paj-rc",
  "version": "0.1.0",
  "description": "Private browser control for live main Paj and Pi sessions on Linux",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "linux"
  ],
  "bin": {
    "paj-rc": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/*.test.js",
    "start": "node dist/src/cli.js serve"
  },
  "files": [
    "dist",
    "extensions",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "paj",
    "remote-control"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
